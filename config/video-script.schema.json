{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Alignment research explainer draft",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "article_id",
    "source_sha256",
    "title",
    "description",
    "research_type",
    "scenes",
    "claims",
    "limitations",
    "credits"
  ],
  "properties": {
    "schema_version": { "type": "integer", "enum": [1] },
    "article_id": { "type": "string" },
    "source_sha256": { "type": "string" },
    "title": { "type": "string" },
    "description": { "type": "string" },
    "research_type": {
      "type": "string",
      "enum": ["empirical", "theoretical", "commentary"]
    },
    "scenes": {
      "type": "array",
      "minItems": 5,
      "maxItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "heading",
          "narration",
          "visual",
          "labels",
          "claim_ids"
        ],
        "properties": {
          "id": { "type": "string" },
          "heading": { "type": "string" },
          "narration": { "type": "string" },
          "visual": {
            "type": "string",
            "enum": [
              "neuron",
              "analogy",
              "comparison",
              "test",
              "takeaway",
              "source"
            ]
          },
          "labels": {
            "type": "array",
            "maxItems": 4,
            "items": { "type": "string" }
          },
          "claim_ids": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "text", "evidence", "kind"],
        "properties": {
          "id": { "type": "string" },
          "text": { "type": "string" },
          "kind": {
            "type": "string",
            "enum": ["finding", "interpretation", "limitation"]
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "maxItems": 3,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["section_id", "quote"],
              "properties": {
                "section_id": { "type": "string" },
                "quote": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": { "type": "string" }
    },
    "credits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authors", "title", "source_url"],
      "properties": {
        "authors": { "type": "array", "items": { "type": "string" } },
        "title": { "type": "string" },
        "source_url": { "type": "string" }
      }
    }
  }
}
