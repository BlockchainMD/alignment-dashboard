{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Alignment research explainer draft",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "article_id",
    "source_sha256",
    "title",
    "description",
    "research_type",
    "teaching_format",
    "scenes",
    "claims",
    "limitations",
    "credits"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "enum": [
        1
      ]
    },
    "article_id": {
      "type": "string"
    },
    "source_sha256": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "research_type": {
      "type": "string",
      "enum": [
        "empirical",
        "theoretical",
        "commentary"
      ]
    },
    "scenes": {
      "type": "array",
      "minItems": 7,
      "maxItems": 11,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "heading",
          "narration",
          "visual",
          "labels",
          "claim_ids",
          "concept_id",
          "concept_title",
          "explanation_level"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "heading": {
            "type": "string"
          },
          "narration": {
            "type": "string"
          },
          "visual": {
            "type": "string",
            "enum": [
              "neuron",
              "analogy",
              "comparison",
              "test",
              "takeaway",
              "source"
            ]
          },
          "labels": {
            "type": "array",
            "maxItems": 4,
            "items": {
              "type": "string"
            }
          },
          "claim_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "concept_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "concept_title": {
            "type": [
              "string",
              "null"
            ]
          },
          "explanation_level": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "technical",
              "plain",
              "simple",
              null
            ]
          }
        }
      }
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "text",
          "evidence",
          "kind"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "finding",
              "interpretation",
              "limitation"
            ]
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "maxItems": 3,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "section_id",
                "quote"
              ],
              "properties": {
                "section_id": {
                  "type": "string"
                },
                "quote": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "string"
      }
    },
    "credits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authors",
        "title",
        "source_url"
      ],
      "properties": {
        "authors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "title": {
          "type": "string"
        },
        "source_url": {
          "type": "string"
        }
      }
    },
    "teaching_format": {
      "type": "string",
      "enum": [
        "three_levels"
      ]
    }
  }
}
