r 2019.","summary_kind":"publisher excerpt","title":"OpenAI Fellows Fall 2018: Final projects","topics":[],"updated_at":null,"url":"https://openai.com/index/openai-fellows-fall-2018"},{"aliases":[],"arxiv_id":null,"authors":[],"content_hash":"296da97b38e2b7dab181437853ddce3566933c8f032a47d60e9fca8d557deda7","date_precision":"instant","discovered_at":"2026-10-16T19:26:59Z","doi":null,"external_id":"https://openai.com/index/transfer-of-adversarial-robustness-between-perturbation-types","first_seen":"2026-10-16T19:26:59Z","id":"7444293e8aabe8f71ce7","links":[],"provenance":[{"article_url":"https://openai.com/index/transfer-of-adversarial-robustness-between-perturbation-types","found_at":"2026-10-16T19:26:59Z","name":"OpenAI","source_id":"openai","url":"https://openai.com/"}],"published_at":"2019-05-03T07:00:00Z","relevance":"candidate","relevance_reason":"discovery candidate; needs review","revision_count":0,"score":0,"source":"OpenAI","source_id":"openai","source_url":"https://openai.com/","summary":"","summary_kind":"publisher excerpt","title":"Transfer of adversarial robustness between perturbation types","topics":[],"updated_at":null,"url":"https://openai.com/index/transfer-of-adversarial-robustness-between-perturbation-types"},{"aliases":[],"arxiv_id":null,"authors":[],"content_hash":"493dca7207aa8a2f373c41bbd962e205b5f8513ee5e6ea5476db60e0783893dc","date_precision":"instant","discovered_at":"2026-10-16T19:26:59Z","doi":null,"external_id":"https://openai.com/index/musenet","first_seen":"2026-10-16T19:26:59Z","id":"e603f49506154d376a1d","links":[],"provenance":[{"article_url":"https://openai.com/index/musenet","found_at":"2026-10-16T19:26:59Z","name":"OpenAI","source_id":"openai","url":"https://openai.com/"}],"published_at":"2019-04-25T07:00:00Z","relevance":"candidate","relevance_reason":"discovery candidate; needs review","revision_count":0,"score":0,"source":"OpenAI","source_id":"openai","source_url":"https://openai.com/","summary":"We’ve created MuseNet, a deep neural network that can generate 4-minute musical compositions with 10 different instruments, and can combine styles from country to Mozart to the Beatles. MuseNet was not explicitly programmed with our understanding of music, but instead discovered patterns of harmony, rhythm, and style by learning to predict the next token in hundreds of thousands of MIDI files. MuseNet uses the same general-purpose unsupervised technology as GPT-2, a large-scale transformer model trained to predict the next token in a sequence, whether audio or text.","summary_kind":"publisher excerpt","title":"MuseNet","topics":[],"updated_at":null,"url":"https://openai.com/index/musenet"},{"aliases":[],"arxiv_id":null,"authors":[],"content_hash":"ec0ea7db70ddb21cced2baa584d612a39395d873911a1546fd3bb4f611cb1208","date_precision":"instant","discovered_at":"2026-10-16T19:26:59Z","doi":null,"external_id":"https://openai.com/index/sparse-transformer","first_seen":"2026-10-16T19:26:59Z","id":"288dc1f2b7856868875c","links":[],"provenance":[{"article_url":"https://openai.com/index/sparse-transformer","found_at":"2026-10-16T19:26:59Z","name":"OpenAI","source_id":"openai","url":"https://openai.com/"}],"published_at":"2019-04-23T07:00:00Z","relevance":"candidate","relevance_reason":"discovery candidate; needs review","revision_count":0,"score":0,"source":"OpenAI","source_id":"openai","source_url":"https://openai.com/","summary":"We’ve developed the Sparse Transformer, a deep neural network which sets new records at predicting what comes next in a sequence—whether text, images, or sound. It uses an algorithmic improvement of the attention mechanism to extract patterns from sequences 30x longer than possible previously.","summary_kind":"publisher excerpt","title":"Generative modeling with sparse transformers","topics":[],"updated_at":null,"url":"https://openai.com/index/sparse-transformer"},{"aliases":[],"arxiv_id":null,"authors":[],"content_hash":"d1b5a66ee9e38048277816f0144ab81e85618104281906d2a7540190380b5bcc","date_precision":"instant","discovered_at":"2026-10-16T19:26:59Z","doi":null,"external_id":"https://openai.com/index/openai-five-defeats-dota-2-world-champions","first_seen":"2026-10-16T19:26:59Z","id":"ee157763b4c2695e1f99","links":[],"provenance":[{"article_url":"https://openai.com/index/openai-five-defeats-dota-2-world-champions","found_at":"2026-10-16T19:26:59Z","name":"OpenAI","source_id":"openai","url":"https://openai.com/"}],"published_at":"2019-04-15T07:00:00Z","relevance":"candidate","relevance_reason":"discovery candidate; needs review","revision_count":0,"score":0,"source":"OpenAI","source_id":"openai","source_url":"https://openai.com/","summary":"OpenAI Five is the first AI to beat the world champions in an esports game, having won two back-to-back games versus the world champion Dota 2 team, OG, at Finals this weekend. Both OpenAI Five and DeepMind’s AlphaStar had previously beaten good pros privately but lost their live pro matches, making this also the first time an AI has beaten esports pros on livestream.","summary_kind":"publisher excerpt","title":"OpenAI Five defeats Dota 2 world champions","topics":[],"updated_at":null,"url":"https://openai.com/index/openai-five-defeats-dota-2-world-champions"},{"aliases":[],"arxiv_id":null,"authors":[],"content_hash":"dc685aac89745bf64256a4e7a08f7563d21f916ab6b88a38f9d68cc99afd3cfb","date_precision":"instant","discovered_at":"2026-10-16T19:26:59Z","doi":null,"external_id":"https://openai.com/index/openai-five-finals","first_seen":"2026-10-16T19:26:59Z","id":"8ccdd7167bb2fcbf2d59","links":[],"provenance":[{"article_url":"https://openai.com/index/openai-five-finals","found_at":"2026-10-16T19:26:59Z","name":"OpenAI","source_id":"openai","url":"https://openai.com/"}],"published_at":"2019-03-26T07:00:00Z","relevance":"candidate","relevance_reason":"discovery candidate; needs review","revision_count":0,"score":0,"source":"OpenAI","source_id":"openai","source_url":"https://openai.com/","summary":"We’ll be holding our final live event for OpenAI Five at 11:30am PT on April 13.","summary_kind":"publisher excerpt","title":"OpenAI Five Finals","topics":[],"updated_at":null,"url":"https://openai.com/index/openai-five-finals"},{"aliases":[],"arxiv_id":null,"authors":[],"content_hash":"e7681316bb3db49cc171b4ceedbe7a24731382a40e04ee27ff5d7406f7107d8f","date_precision":"instant","discovered_at":"2026-10-16T19:26:59Z","doi":null,"external_id":"https://openai.com/index/energy-based-models","first_seen":"2026-10-16T19:26:59Z","id":"a193572aa133c67f2d29","links":[],"provenance":[{"article_url":"https://openai.com/index/energy-based-models","found_at":"2026-10-16T19:26:59Z","name":"OpenAI","source_id":"openai","url":"https://openai.com/"}],"published_at":"2019-03-21T07:00:00Z","relevance":"candidate","relevance_reason":"discovery candidate; needs review","revision_count":0,"score":0,"source":"OpenAI","source_id":"openai","source_url":"https://openai.com/","summary":"We’ve made progress towards stable and scalable training of energy-based models (EBMs) resulting in better sample quality and generalization ability than existing models. Generation in EBMs spends more compute to continually refine its answers and doing so can generate samples competitive with GANs at low temperatures, while also having mode coverage guarantees of likelihood-based models. We hope these findings stimulate further research into this promising class of models.","summary_kind":"publisher excerpt","title":"Implicit generation and generalization methods for energy-based models","topics":[],"updated_at":null,"url":"https://openai.com/index/energy-based-models"},{"aliases":[],"arxiv_id":null,"authors":[],"content_hash":"e0e582a9ea324fc266808a52a6b0d70d07287c8c81857f704634f0affa94553d","date_precision":"instant","discovered_at":"2026-10-16T19:26:59Z","doi":null,"external_id":"https://openai.com/index/openai-scholars-2019-meet-our-scholars","first_seen":"2026-10-16T19:26:59Z","id":"e9714360702c5dfab29c","links":[],"provenance":[{"article_url":"https://openai.com/index/openai-scholars-2019-meet-our-scholars","found_at":"2026-10-16T19:26:59Z","name":"OpenAI","source_id":"openai","url":"https://openai.com/"}],"published_at":"2019-03-13T07:00:00Z","relevance":"candidate","relevance_reason":"discovery candidate; needs review","revision_count":0,"score":0,"source":"OpenAI","source_id":"openai","source_url":"https://openai.com/","summary":"Our class of eight scholars (out of 550 applicants) brings together collective expertise in literature, philosophy, cell biology, statistics, economics, quantum physics, and business innovation.","summary_kind":"publisher excerpt","title":"OpenAI Scholars 2019: Meet our Scholars","topics":[],"updated_at":null,"url":"https://openai.com/index/openai-scholars-2019-meet-our-scholars"},{"aliases":[],"arxiv_id":null,"authors":[],"content_hash":"be4dc015fa93ee834726c79eca1098bc35e4abec1a533f65beb9a1e7f2fd430d","date_precision":"instant","discovered_at":"2026-10-16T19:26:59Z","doi":null,"external_id":"https://openai.com/index/openai-lp","first_seen":"2026-10-16T19:26:59Z","id":"88a14177a3cd22d160db","links":[],"provenance":[{"article_url":"https://openai.com/index/openai-lp","found_at":"2026-10-16T19:26:59Z","name":"OpenAI","source_id":"openai","url":"https://openai.com/"}],"published_at":"2019-03-11T07:00:00Z","relevance":"candidate","relevance_reason":"discovery candidate; needs review","revision_count":0,"score":0,"source":"OpenAI","source_id":"openai","source_url":"https://openai.com/","summary":"We’ve created OpenAI LP, a new “capped-profit” company that allows us to rapidly increase our investments in compute and talent while including checks and balances to actualize our mission.","summary_kind":"publisher excerpt","title":"OpenAI LP","topics":[],"updated_at":null,"url":"https://openai.com/index/openai-lp"},{"aliases":[],"arxiv_id":null,"authors":[],"content_hash":"ac9eceb25ddda6b51abc0933792704346b83bbe38d38547aa734e8013bf59ef0","date_precision":"instant","discovered_at":"2026-10-16T19:26:59Z","doi":null,"external_id":"https://openai.com/index/introducing-activation-atlases","first_seen":"2026-10-16T19:26:59Z","id":"e4ccd46451d8f5ccd063","links":[],"provenance":[{"article_url":"https://openai.com/index/introducing-activation-atlases","found_at":"2026-10-16T19:26:59Z","name":"OpenAI","source_id":"openai","url":"https://openai.com/"}],"published_at":"2019-03-06T08:00:00Z","relevance":"candidate","relevance_reason":"discovery candidate; needs review","revision_count":0,"score":0,"source":"OpenAI","source_id":"openai","source_url":"https://openai.com/","summary":"We’ve created activation atlases (in collaboration with Google researchers), a new technique for visualizing what interactions between neurons can represent. As AI systems are deployed in increasingly sensitive contexts, having a better understanding of their internal decision-making processes will let us identify weaknesses and investigate failures.","summary_kind":"publisher excerpt","title":"Introducing Activation Atlases","topics":[],"updated_at":null,"url":"https://openai.com/index/introducing-activation-atlases"},{"aliases":[],"arxiv_id":null,"authors":[],"content_hash":"42afe30b50008a818cb7a4573f259ecc5183b9ddea6a89afb1768c77458bac43","date_precision":"instant","discovered_at":"2026-10-16T19:26:59Z","doi":null,"external_id":"https://openai.com/index/neural-mmo","first_seen":"2026-10-16T19:26:59Z","id":"5543eae6f599212338d1","links":[],"provenance":[{"article_url":"https://openai.com/index/neural-mmo","found_at":"2026-10-16T19:26:59Z","name":"OpenAI","source_id":"openai","url":"https://openai.com/"}],"published_at":"2019-03-04T08:00:00Z","relevance":"candidate","relevance_reason":"discovery candidate; needs review","revision_count":0,"score":0,"source":"OpenAI","source_id":"openai","source_url":"https://openai.com/","summary":"We’re releasing a Neural MMO, a massively multiagent game environment for reinforcement learning agents. Our platform supports a large, variable number of agents within a persistent and open-ended task. The inclusion of many agents and species leads to better exploration, divergent niche formation, and greater overall competence.","summary_kind":"publisher excerpt","title":"Neural MMO: A massively multiagent game environment","topics":[],"updated_at":null,"url":"https://openai.com/index/neural-mmo"},{"aliases":[],"arxiv_id":null,"authors":[],"content_hash":"e1cfd2787fe1eb936f33de3930a9725d0370467be0c3e043ef4651a5bc97b049","date_precision":"instant","discovered_at":"2026-10-16T19:26:59Z","doi":null,"external_id":"https://openai.com/index/spinning-up-in-deep-rl-workshop-review","first_seen":"2026-10-16T19:26:59Z","id":"5ddf2cf5bc6ba7a0aded","links":[],"provenance":[{"article_url":"https://openai.com/index/spinning-up-in-deep-rl-workshop-review","found_at":"2026-10-16T19:26:59Z","name":"OpenAI","source_id":"openai","url":"https://openai.com/"}],"published_at":"2019-02-26T08:00:00Z","relevance":"candidate","relevance_reason":"discovery candidate; needs review","revision_count":0,"score":0,"source":"OpenAI","source_id":"openai","source_url":"https://openai.com/","summary":"On February 2, we held our first Spinning Up Workshop as part of our new education initiative at OpenAI.","summary_kind":"publisher excerpt","title":"Spinning Up in Deep RL: Workshop review","topics":[],"updated_at":null,"url":"https://openai.com/index/spinning-up-in-deep-rl-workshop-review"},{"aliases":[],"arxiv_id":null,"authors":[],"content_hash":"6843365988fc1830df8b8b60ae118ad8c52e97fe0afd66e8a4b731a294d5b5a9","date_precision":"instant","discovered_at":"2026-10-16T19:26:59Z","doi":null,"external_id":"https://openai.com/index/ai-safety-needs-social-scientists","first_seen":"2026-10-16T19:26:59Z","id":"badf447fbf1d9ecc61c6","links":[],"provenance":[{"article_url":"https://openai.com/index/ai-safety-needs-social-scientists","found_at":"2026-10-16T19:26:59Z","name":"OpenAI","source_id":"openai","url":"https://openai.com/"}],"published_at":"2019-02-19T08:00:00Z","relevance":"relevant","relevance_reason":"topic heuristic","revision_count":0,"score":6,"source":"OpenAI","source_id":"openai","source_url":"https://openai.com/","summary":"We’ve written a paper arguing that long-term AI safety research needs social scientists to ensure AI alignment algorithms succeed when actual humans are involved. Properly aligning advanced AI systems with human values requires resolving many uncertainties related to the psychology of human rationality, emotion, and biases. The aim of this paper is to spark further collaboration between machine learning and social science researchers, and we plan to hire social scientists to work on this full time at OpenAI.","summary_kind":"publisher excerpt","title":"AI safety needs social scientists","topics":["Alignment methods"],"updated_at":null,"url":"https://openai.com/index/ai-safety-needs-social-scientists"},{"aliases":[],"arxiv_id":null,"authors":[],"content_hash":"2ea57a2351f0103e1dced43a15c56e8e019baaf521856880c0e9a174f0316b9b","date_precision":"instant","discovered_at":"2026-10-16T19:26:59Z","doi":null,"external_id":"https://openai.com/index/better-language-models","first_seen":"2026-10-16T19:26:59Z","id":"1b5948ab02410cc11a7e","links":[],"provenance":[{"article_url":"https://openai.com/index/better-language-models","found_at":"2026-10-16T19:26:59Z","name":"OpenAI","source_id":"openai","url":"https://openai.com/"}],"published_at":"2019-02-14T08:00:00Z","relevance":"candidate","relevance_reason":"discovery candidate; needs review","revision_count":0,"score":0,"source":"OpenAI","source_id":"openai","source_url":"https://openai.com/","summary":"We’ve trained a large-scale unsupervised language model which generates coherent paragraphs of text, achieves state-of-the-art performance on many language modeling benchmarks, and performs rudimentary reading comprehension, machine translation, question answering, and summarization—all without task-specific training.","summary_kind":"publisher excerpt","title":"Better language models and their implications","topics":[],"updated_at":null,"url":"https://openai.com/index/better-language-models"},{"aliases":[],"arxiv_id":null,"authors":[],"content_hash":"dba0cc6d21cd22c58c308823eedbb1e0543418267cf276aba2ba17b7f07b37b2","date_precision":"instant","discovered_at":"2026-10-16T19:26:59Z","doi":null,"external_id":"https://openai.com/index/computational-limitations-in-robust-classification-and-win-win-results","first_seen":"2026-10-16T19:26:59Z","id":"8eb7839a3c9c02a2d138","links":[],"provenance":[{"article_url":"https://openai.com/index/computational-limitations-in-robust-classification-and-win-win-results","found_at":"2026-10-16T19:26:59Z","name":"OpenAI","source_id":"openai","url":"https://openai.com/"}],"published_at":"2019-02-04T08:00:00Z","relevance":"candidate","relevance_reason":"discovery candidate; needs review","revision_count":0,"score":0,"source":"OpenAI","source_id":"openai","source_url":"https://openai.com/","summary":"","summary_kind":"publisher excerpt","title":"Computational limitations in robust classification and win-win results","topics":[],"updated_at":null,"url":"https://openai.com/index/computational-limitations-in-robust-classification-and-win-win-results"}],"schema_version":1}
